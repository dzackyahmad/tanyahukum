{
  "name": "tanyahukum-app",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.js",
    "test:unit:ci": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.js --ci --runInBand --reporters=default --reporters=jest-junit",
    "test:e2e": "playwright test",
    "test:perf:smoke": "node ./tests/performance/run-smoke.mjs",
    "test:security:lint": "node ./tests/security/run-security-checks.mjs",
    "test:security:audit": "node ./tests/security/run-npm-audit.mjs"
  },
  "dependencies": {
    "@langchain/community": "^1.1.25",
    "@langchain/core": "^1.1.35",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/pinecone": "^1.0.1",
    "@langchain/textsplitters": "^1.0.1",
    "@pinecone-database/pinecone": "^5.1.2",
    "@prisma/client": "6.19.2",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.3.4",
    "google-auth-library": "^10.6.2",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.2.35",
    "llama-cloud-services": "^0.5.4",
    "llamaindex": "^0.12.1",
    "lru-cache": "^11.3.3",
    "midtrans-client": "^1.4.3",
    "next": "^16.3.8",
    "nodemailer": "^8.0.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "voyageai": "^0.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^30.0.5",
    "jest-junit": "^16.0.0",
    "playwright": "^1.55.0",
    "postcss": "^8.5.10",
    "prisma": "6.19.2",
    "tailwindcss": "^3.4.19",
    "undici": "^7.13.0"
  }
}
