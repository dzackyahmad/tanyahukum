  DB --> API : messages[]
  deactivate DB
  API --> UI : HTTP 200 {history: messages}

else fallback (legacy)
  API -> DB : chatHistory.findMany(\n  {where: {userId}}\n  orderBy: {createdAt: asc}\n)
  activate DB
  DB --> API : allHistory[]
  deactivate DB
  API --> UI : HTTP 200 {history: allHistory}
end

deactivate API
UI --> USER : tampil daftar chat\n/ pesan dalam chat
deactivate UI

@enduml

