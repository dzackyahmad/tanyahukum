' ============================================================
' SEQ-07: REGISTRASI EMAIL
' ============================================================
@startuml SEQ-07-Register
title Sequence Diagram — Registrasi Email\nPOST /api/auth/register

skinparam sequence {
  ActorBackgroundColor #FDEBD0
  ActorBorderColor #e67e22
  ParticipantBackgroundColor #EEF4FF
  ParticipantBorderColor #2f6fed
  LifeLineBorderColor #2c3e50
  ArrowColor #2c3e50
  ArrowFontSize 10
}

actor "Pengguna" as USER
participant "RegisterForm\n(React)" as UI
participant "POST /api/auth/register\n(Route Handler)" as API
participant "rateLimit\n(LRU Cache)" as RL
database "PostgreSQL\n(Prisma)" as DB
participant "bcryptjs" as BCRYPT

USER -> UI : isi form email + password\nklik Daftar Sekarang
activate UI

UI -> API : POST /api/auth/register\n{email, password}
activate API

API -> RL : rateLimit(ip, 10)
activate RL
RL --> API : allowed / blocked
deactivate RL

alt Rate limit tercapai
  API --> UI : HTTP 429\n"Terlalu banyak permintaan"
  UI --> USER : tampil pesan error
end

API -> API : normalisasi email\n(trim + toLowerCase)

alt Email atau password kosong
  API --> UI : HTTP 400\n"Email dan password wajib diisi"
end

alt Format email tidak valid
  API --> UI : HTTP 400\n"Format email tidak valid"
end

alt Password < 8 karakter
  API --> UI : HTTP 400\n"Password minimal 8 karakter"
end

API -> DB : user.findUnique({email})
activate DB
DB --> API : existingUser | null
deactivate DB

alt Email sudah terdaftar via Google
  API --> UI : HTTP 409\n"Gunakan tombol Login with Google"
  UI --> USER : tampil pesan hint Google
end

alt Email sudah terdaftar
  API --> UI : HTTP 409\n"Email sudah digunakan"
  UI --> USER : tampil pesan error
end

API -> BCRYPT : hash(password, saltRounds: 10)
activate BCRYPT
BCRYPT --> API : passwordHash
deactivate BCRYPT

API -> DB : user.create(\n  {email, passwordHash}\n  default: tier=FREE, role=USER\n)
activate DB

alt Race condition — P2002 unique constraint
  DB --> API : PrismaClientKnownRequestError P2002
  deactivate DB
  API --> UI : HTTP 409\n"Email sudah digunakan"
end

DB --> API : user baru
deactivate DB

API --> UI : HTTP 201\n"Registrasi berhasil"
deactivate API

UI -> UI : onSwitchToLogin()\n(arahkan ke form login)
UI --> USER : notifikasi sukses\npindah ke halaman login
deactivate UI

@enduml

