' ============================================================
' SEQ-09: GET PROFILE (termasuk self-healing PRO)
' ============================================================
@startuml SEQ-09-GetProfile
title Sequence Diagram — Lihat Profil & Self-Healing\nGET /api/profile

skinparam sequence {
  ActorBackgroundColor #FDEBD0
  ActorBorderColor #e67e22
  ParticipantBackgroundColor #EEF4FF
  ParticipantBorderColor #2f6fed
  LifeLineBorderColor #2c3e50
  ArrowColor #2c3e50
  ArrowFontSize 10
}

actor "Pengguna" as USER
participant "Frontend\n(React)" as UI
participant "GET /api/profile\n(Route Handler)" as API
participant "verifyToken()\n(jsonwebtoken)" as JWT
database "PostgreSQL\n(Prisma)" as DB
participant "Midtrans\nCoreAPI" as MIDTRANS

USER -> UI : buka halaman profil
activate UI

UI -> API : GET /api/profile\n[Cookie: token=...]
activate API

API -> API : cookies.get("token")

alt Token tidak ada
  API --> UI : HTTP 401 "Unauthorized"
  UI --> USER : redirect ke login
end

API -> JWT : verifyToken(token)
activate JWT
JWT --> API : payload {userId}
deactivate JWT

API -> DB : user.findUnique(\n  {id: userId}\n  select: id,name,email,avatarUrl\n  tier,promptLimit,personalContext\n)
activate DB
DB --> API : user
deactivate DB

alt User tidak ditemukan
  API --> UI : HTTP 404
end

note over API, MIDTRANS
  Self-Healing: cek jika webhook Midtrans terlambat/gagal
end note

alt user.tier === "FREE"
  API -> DB : transaction.findFirst(\n  {userId, status: "PENDING"}\n  orderBy: createdAt desc\n)
  activate DB
  DB --> API : pendingTx | null
  deactivate DB

  alt Ada transaksi PENDING
    API -> MIDTRANS : CoreAPI.transaction\n.status(pendingTx.orderId)
    activate MIDTRANS
    MIDTRANS --> API : {transaction_status}
    deactivate MIDTRANS

    alt status = "settlement" atau "capture"
      API -> DB : $transaction([\n  transaction.update({SUCCESS})\n  user.update({tier:PRO, promptLimit:0})\n])
      activate DB
      DB --> API : ok (atomic)
      deactivate DB
      API -> API : user.tier = "PRO"\nuser.promptLimit = 0
    end
  end
end

API --> UI : HTTP 200\n{id, name, email, avatarUrl\ntier, promptLimit, personalContext}
deactivate API

UI --> USER : tampil data profil\n(dengan badge PRO jika tier=PRO)
deactivate UI

@enduml

' ============================================================
' SEQ-10: PATCH PROFILE (update data profil)
' ============================================================
@startuml SEQ-10-UpdateProfile
title Sequence Diagram — Update Profil\nPATCH /api/profile

skinparam sequence {
  ActorBackgroundColor #FDEBD0
  ActorBorderColor #e67e22
  ParticipantBackgroundColor #EEF4FF
  ParticipantBorderColor #2f6fed
  LifeLineBorderColor #2c3e50
  ArrowColor #2c3e50
  ArrowFontSize 10
}

actor "Pengguna" as USER
participant "ProfileForm\n(React)" as UI
participant "PATCH /api/profile\n(Route Handler)" as API
participant "verifyToken()" as JWT
database "PostgreSQL\n(Prisma)" as DB
participant "bcryptjs" as BCRYPT

USER -> UI : edit nama / email / password\n/ personalContext / avatarUrl
activate UI

UI -> API : PATCH /api/profile\n{name?, email?, currentPassword?\nnewPassword?, avatarUrl?, personalContext?}
activate API

API -> JWT : verifyToken(token cookie)
activate JWT
JWT --> API : payload {userId}
deactivate JWT

alt Token tidak ada / invalid
  API --> UI : HTTP 401
end

API -> DB : user.findUnique({id: userId})
activate DB
DB --> API : existingUser
deactivate DB

alt User tidak ditemukan
  API --> UI : HTTP 404
end

API -> API : susun updateData = {}
note right of API
  Hanya field yang dikirim yang diupdate.
  Field tidak dikirim = tidak berubah.
end note

alt avatarUrl dikirim && bukan null && tidak diawali "http"
  API --> UI : HTTP 400 "URL Avatar tidak valid"
end

alt newPassword dikirim
  alt currentPassword tidak ada
    API --> UI : HTTP 400 "Password lama wajib diisi"
  end

  API -> BCRYPT : compare(currentPassword, existingUser.passwordHash)
  activate BCRYPT
  BCRYPT --> API : isMatch: boolean
  deactivate BCRYPT

  alt Password lama salah
    API --> UI : HTTP 401 "Password lama salah"
  end

  alt newPassword < 8 karakter
    API --> UI : HTTP 400 "Password minimal 8 karakter"
  end

  API -> BCRYPT : hash(newPassword, saltRounds: 10)
  activate BCRYPT
  BCRYPT --> API : passwordHash baru
  deactivate BCRYPT

  API -> API : updateData.passwordHash = hash baru
end

alt personalContext dikirim && length > 500
  API --> UI : HTTP 400 "Konteks personal maksimal 500 karakter"
end

alt updateData kosong (tidak ada field yang berubah)
  API --> UI : HTTP 400 "Tidak ada perubahan data"
end

API -> DB : user.update(\n  {id: userId}\n  data: updateData\n  select: id,name,email,avatarUrl\n)
activate DB
DB --> API : updatedUser
deactivate DB

API --> UI : HTTP 200\n{message: "Profil berhasil diperbarui"\nuser: updatedUser}
deactivate API

UI --> USER : tampil notifikasi sukses\ndata profil diperbarui
deactivate UI

@enduml

