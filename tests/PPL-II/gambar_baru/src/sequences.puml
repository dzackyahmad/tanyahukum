' ============================================================
' SEQ-18: DOWNLOAD PDF (proxy server)
' ============================================================
@startuml SEQ-18-DownloadPDF
title Sequence Diagram — Download Dokumen PDF\nGET /api/regulations/download

skinparam sequence {
  ActorBackgroundColor #FDEBD0
  ActorBorderColor #e67e22
  ParticipantBackgroundColor #EEF4FF
  ParticipantBorderColor #2f6fed
  LifeLineBorderColor #2c3e50
  ArrowColor #2c3e50
  ArrowFontSize 10
}

actor "Pengguna" as USER
participant "DataPage\n(React)" as UI
participant "GET /api/regulations/download\n(Route Handler — Proxy)" as API
participant "Supabase Storage\n(legal-documents)" as SUPABASE

USER -> UI : klik tombol Unduh
activate UI

UI -> API : GET /api/regulations/download\n?url={supabaseUrl}&name={fileName}
activate API

alt Parameter url tidak ada
  API --> UI : HTTP 400 "URL file tidak ditemukan"
end

API -> API : new URL(fileUrl)\nvalidasi hostname

alt URL tidak bisa di-parse
  API --> UI : HTTP 400 "URL tidak valid"
end

alt hostname bukan "supabase.co" &&\ntidak endsWith ".supabase.co"
  API --> UI : HTTP 400 "URL tidak diizinkan"\n(SSRF diblokir)
  UI --> USER : tampil error
end

API -> SUPABASE : fetch(fileUrl\n  {headers: {Accept: "application/pdf,*/*"}})\n[server-side, bypass CORS browser]
activate SUPABASE

alt File tidak ditemukan di storage
  SUPABASE --> API : HTTP 404
  deactivate SUPABASE
  API --> UI : HTTP 404 "Dokumen tidak ditemukan"
end

SUPABASE --> API : stream PDF
deactivate SUPABASE

API -> API : buffer = await arrayBuffer()\nsafeFileName = fileName\n  .replace(/[^a-zA-Z0-9._\\- ]/g, "_")

API --> UI : HTTP 200\nContent-Type: application/pdf\nContent-Disposition: attachment; filename="{safeFileName}"\nContent-Length: {size}\nCache-Control: no-store\n[binary PDF buffer]
deactivate API

UI --> USER : browser otomatis\ndownload file PDF
