end

alt type === "list"
  API -> DB : chat.findMany(\n  {where: {userId}}\n  orderBy: {updatedAt: desc}\n)
  activate DB
  DB --> API : chats[]
  deactivate DB
  API --> UI : HTTP 200 {chats}

else chatId ada di query param
  API -> DB : chatHistory.findMany(\n  {where: {chatId}}\n  orderBy: {createdAt: asc}\n)
