'==============================================================
' FLOWCHART SISTEM TANYAHUKUM
' Pendekatan: Prosedural/Struktural
' Tool: PlantUML Activity Diagram
'==============================================================

' ============================================================
' 1. ALUR REGISTRASI
' ============================================================
@startuml FC-01-Register
title FC-01: Alur Registrasi Pengguna\nPOST /api/auth/register

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start
:Pengguna mengisi form registrasi\n(email, password);
:Sistem cek rate limit IP\n(maks 10 req/menit);

if (Rate limit tercapai?) then (Ya)
  :Kembalikan\nHTTP 429;
  stop
endif

:Normalisasi email\n(trim + lowercase);

if (Email atau password kosong?) then (Ya)
  :Kembalikan\nHTTP 400;
  stop
endif

if (Format email tidak valid?) then (Ya)
  :Kembalikan\nHTTP 400;
  stop
endif

if (Password < 8 karakter?) then (Ya)
  :Kembalikan\nHTTP 400;
  stop
endif

:Query DB — cek email sudah ada?;

if (Email sudah terdaftar?) then (Ya)
  if (Provider = GOOGLE?) then (Ya)
    :Kembalikan HTTP 409\n+ hint "pakai tombol Google";
    stop
  else (Tidak)
    :Kembalikan HTTP 409\n"Email sudah digunakan";
    stop
  endif
endif

:Hash password dengan bcrypt\n(salt rounds 10);
:Simpan user baru ke database\n(tier: FREE, role: USER);

if (DB constraint P2002 (race condition)?) then (Ya)
  :Kembalikan HTTP 409;
  stop
endif

:Kembalikan HTTP 201\n"Registrasi berhasil";
stop
@enduml

' ============================================================
' 2. ALUR LOGIN
' ============================================================
@startuml FC-02-Login
title FC-02: Alur Login\nPOST /api/auth/login

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start
:Pengguna mengirim email & password;
:Sistem cek rate limit IP\n(maks 5 percobaan/menit);

if (Rate limit tercapai?) then (Ya)
  :Kembalikan HTTP 429;
  stop
endif

:Parse request body JSON;

if (Body bukan JSON valid?) then (Ya)
  :Kembalikan HTTP 400\n"Request body tidak valid";
  stop
endif

:Validasi format email & panjang password;

if (Validasi gagal?) then (Ya)
  :Kembalikan HTTP 400;
  stop
endif

:Normalisasi email (lowercase);

if (rateLimit(email, 10/menit, "login-email") terlampaui?) then (Ya)
  :Kembalikan HTTP 429;
  stop
endif

:Query DB — cari user berdasarkan email;
note right
  Jika user tidak ditemukan,
  tetap jalankan bcrypt.compare
  dengan dummy hash untuk
  mencegah timing attack
end note

:bcrypt.compare(password, hash);

if (Gagal DAN user ada DAN password\npunya spasi di awal/akhir?) then (Ya)
  :bcrypt.compare(password.trim(), hash);
  note right
    Perbaikan (BUG-07): registrasi
    menyimpan password ter-trim.
  end note
endif

if (!user || password tidak cocok?) then (Ya)
  :Kembalikan HTTP 401\n"Email atau password salah";
  stop
endif

:Buat JWT token\n(userId, email, tier, role);
:Set cookie HttpOnly "token"\n(maxAge: 7 hari, sameSite: lax);
:Kembalikan HTTP 200\n+ data user;
stop
@enduml

' ============================================================
' 3. ALUR LOGIN GOOGLE OAUTH
' ============================================================
@startuml FC-03-GoogleOAuth
title FC-03: Alur Login / Register via Google OAuth\nPOST /api/auth/google

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start
:Pengguna klik tombol "Login with Google";
:Browser memuat Google Sign-In (GSI) SDK;
:Pengguna memilih akun Google;
:Google mengembalikan credential token\nke callback frontend;
:Frontend kirim POST /api/auth/google\n{credentialToken};

if (credentialToken tidak ada?) then (Ya)
  :Kembalikan HTTP 400;
  stop
endif

:Verifikasi token ke server Google\n(client.verifyIdToken);

if (Token palsu / tidak valid?) then (Ya)
  :Kembalikan HTTP 401;
  stop
endif

:Ambil payload\n(email, name, picture);

if (Email tidak ada di payload?) then (Ya)
  :Kembalikan HTTP 400;
  stop
endif

:Query DB — cari user berdasarkan email;

if (User belum terdaftar?) then (Ya)
  :Auto-register user baru\n(authProvider: GOOGLE\ntier: FREE, role: USER);
endif

:Buat JWT token;
:Set cookie HttpOnly "token";
:Kembalikan HTTP 200\n+ data user;
stop
@enduml

' ============================================================
' 4. ALUR LUPA & RESET PASSWORD
' ============================================================
@startuml FC-04-ForgotResetPassword
title FC-04: Alur Lupa & Reset Password\nPOST /api/auth/forgot-password\nPOST /api/auth/reset-password

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start
partition "Tahap 1 — Forgot Password" {
  :Pengguna masukkan email;
  :Cek rate limit\n(maks 3 req / 15 menit);

  if (Rate limit tercapai?) then (Ya)
    :Kembalikan HTTP 429;
    stop
  endif

  if (Email kosong atau format salah?) then (Ya)
    :Kembalikan HTTP 400;
    stop
  endif

  :Query DB — cari user;

  if (User tidak ditemukan?) then (Ya)
    :Kembalikan HTTP 200\npesan generik\n(anti user-enumeration);
    stop
  endif

  :Generate random token\n(crypto.randomBytes 32);
  :Hash token dengan SHA-256;
  :Simpan hashed token + expiry\n(+1 jam) ke DB;
  :Kirim email berisi\nlink reset (token plaintext);
  :Kembalikan HTTP 200\npesan generik;
}

partition "Tahap 2 — Reset Password" {
  :Pengguna klik link di email\n(/reset-password?token=xxx);
  :Pengguna masukkan password baru;
  :Kirim POST /api/auth/reset-password\n{token, newPassword};

  if (Token atau password tidak ada?) then (Ya)
    :Kembalikan HTTP 400;
    stop
  endif

  if (Password < 8 karakter?) then (Ya)
    :Kembalikan HTTP 400;
    stop
  endif

  :Hash token dari URL (SHA-256);
  :Query DB — cari user dengan\nhashed token & expiry > now();

  if (Token tidak valid / expired?) then (Ya)
    :Kembalikan HTTP 400;
    stop
  endif

  :Hash password baru (bcrypt salt 12);
  :Update DB:\n- passwordHash = hash baru\n- resetToken = null\n- resetTokenExpiry = null;
  :Kembalikan HTTP 200\n"Password berhasil diubah";
}
stop
@enduml

' ============================================================
' 5. ALUR LOGOUT
' ============================================================
@startuml FC-05-Logout
title FC-05: Alur Logout\nPOST /api/logout

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start
:Pengguna klik tombol Logout;
:Frontend kirim POST /api/logout;
:Ambil sesi Supabase (getUser);

if (Ada sesi Supabase aktif?) then (Ya)
  :signOut global Supabase\n(invalidate server session);
endif

:Set cookie "token" = ""\n(expires: epoch 0 — hapus cookie JWT);
:Redirect ke /login (HTTP 303);
:Hapus data localStorage\n(user, conversations, active_conversation_id);
:Dispatch event "auth-change"\nke semua komponen;
stop
@enduml

' ============================================================
' 6. ALUR MIDDLEWARE (AUTH GUARD ADMIN)
' ============================================================
@startuml FC-06-Middleware
title FC-06: Alur Middleware — CSRF & Guard Halaman/API\nmiddleware.js

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start
:Request masuk ke sistem;
:Baca cookie "token" dari request;

if (Request /api yang mengubah data\ndari origin lain? (CSRF)) then (Ya)
  :Kembalikan HTTP 403\n"cross-origin request";
  stop
endif

if (Halaman /admin*?) then (Ya)
  if (Role di JWT bukan ADMIN?) then (Ya)
    :Redirect ke /chatbot;
    stop
  endif
endif

if (Halaman /dashboard* atau /pusat-data*?) then (Ya)
  if (Tidak ada JWT yang valid?) then (Ya)
    :Redirect ke /chatbot\n(tamu login dari sana);
    stop
  endif
endif

if (Path dimulai dengan /api/admin?) then (Ya)
  if (Token tidak ada?) then (Ya)
    :Kembalikan HTTP 401\n"Harap login terlebih dahulu";
    stop
  endif

  if (JWT_SECRET tidak di-set?) then (Ya)
    :Kembalikan HTTP 500\n"Server configuration error"\n(fail-closed);
    stop
  endif

  :Verifikasi JWT\n(jose.jwtVerify);

  if (Token tidak valid / expired?) then (Ya)
    :Kembalikan HTTP 401\n"Token tidak valid";
    stop
  endif

  if (role !== ADMIN?) then (Ya)
    :Kembalikan HTTP 403\n"Admin access only";
    stop
  endif

else (Tidak)
  note right: Endpoint publik & user\ntidak butuh pengecekan admin
endif

:Set Cache-Control headers\n(no-store, no-cache);
:Teruskan request ke handler;
stop
@enduml

' ============================================================
' 7. ALUR CHAT RAG (FITUR UTAMA)
' ============================================================
@startuml FC-07-ChatRAG
title FC-07: Alur Chat RAG — Mode Streaming (Fitur Utama)\nPOST /api/chat {stream:true}

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start
:Pengguna pilih model & mode\n(5 model x Kilat/Berpikir), ketik pertanyaan\ndan klik Kirim;
:Frontend kirim POST /api/chat\n{message, chatId?, mode, preferences, stream:true};

:Verifikasi sesi dari JWT cookie\n(getSession);

if (Sesi tidak ada?) then (Ya)
  :Kembalikan HTTP 401;
  stop
endif

if (Pesan kosong atau > 5000 karakter?) then (Ya)
  :Kembalikan HTTP 400;
  stop
endif

if (rateLimit(userId, 15/menit) terlampaui?) then (Ya)
  :Kembalikan HTTP 429;
  stop
endif

:Ambil userId dari JWT\n(bukan dari body!);
:Baca DB paralel (Promise.all):\nuser, existingChat (jika chatId),\npromptUsage.count hari ini;

if (chatId ada tapi bukan milik user\nATAU user tidak ditemukan?) then (Ya)
  :Kembalikan HTTP 404;
  stop
endif

if (tier = FREE\nDAN count PromptUsage hari ini >= promptLimit?) then (Ya)
  :Kembalikan HTTP 403\n{limitReached: true};
  stop
else (Tidak / PRO bypass)
endif

partition "Pipeline RAG (streaming)" {
  :Kirim event NDJSON "step" {search, active};
  :Embed pertanyaan\n(VoyageAI voyage-law-2,\ndi-cache per pertanyaan sama);
  :Query Pinecone Vector DB\n(topK: 50, includeMetadata: true);
  :cleanMatches(): buang duplikat\n& noise OCR (5 teratas tetap dipertahankan);
  :Kirim event "sources" {count, used, docs}\n"step" {search, done};

  if (user.personalContext ada?) then (Ya)
    :Tambahkan konteks personal\nsebagai invisible context;
  endif
  :Sisipkan preferensi gaya jawaban\n(whitelist, anti prompt injection);
  :Bangun system prompt\n(role + dokumen hukum + aturan format + preferensi);

  repeat :Ambil model berikutnya dari modelChain\n(model pilihan dulu, lalu cadangan Gemini);
    :Kirim event "model" {model, provider,\nmode, fallback};
    :Stream dari Gemini/Groq\n(AbortController untuk Stop);

    if (Pengguna menekan Stop?) then (Ya)
      :abortController.abort();
      if (Sudah sempat menulis jawaban?) then (Ya)
        :Simpan PromptUsage (kuota tetap terpakai);
      endif
      :Tutup stream, TIDAK simpan riwayat;
      stop
    endif

    if (Gagal SEBELUM mulai menulis\n(kuota 429/413 atau server 5xx)?) then (Ya)
      :Catat error, lanjut ke model berikutnya;
    else (Berhasil menulis / gagal setelah menulis)
      :Kirim event "thinking"? + "text"\n(tiap chunk jawaban);
    endif
  repeat while (Masih ada model lain\nDAN belum berhasil menulis?) is (Ya) not (Tidak)

  if (Semua model gagal?) then (Ya)
    :Kirim event "error"\n"Kuota AI hari ini telah habis";
    stop
  endif
}

if (chatId dikirim di body?) then (Ya)
  :pakai existingChat yang sudah divalidasi;
else (Tidak)
  :Buat chat baru\n(title = 30 char pertama pesan);
endif

:Simpan ke DB secara paralel\n(Promise.all):
note right
  1. promptUsage.create (catat kuota)
  2. ChatHistory role=USER (pertanyaan)
  3. ChatHistory role=AI (jawaban)
  4. Update chat.updatedAt
end note

:Kirim event "done"\n{chatId, answer, model, mode, durationMs};
:Frontend tampilkan jawaban lengkap\n(Markdown + panel Proses + sitasi bisa diklik);
stop
@enduml

' ============================================================
' 8. ALUR MANAJEMEN PROFIL
' ============================================================
@startuml FC-08-Profile
title FC-08: Alur Manajemen Profil (5 Tab)\nGET/PATCH/DELETE /api/profile + Personalisasi + Akun

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start

split
partition "GET — Lihat Profil" {
  :Baca cookie token;
  if (Token tidak ada?) then (Ya)
    :HTTP 401;
    stop
  endif
  :verifyToken → findUnique user;
  if (tier = FREE?) then (Ya)
    :Cek transaksi PENDING di DB;
    if (Ada PENDING?) then (Ya)
      :Cek status ke Midtrans CoreAPI;
      if (Status settlement / capture?) then (Ya)
        :Upgrade user ke PRO\n(atomic DB transaction);
      endif
    endif
  endif
  :Kembalikan HTTP 200\ndata profil user;
}

split again
partition "PATCH — Update Profil" {
  :Baca cookie token;
  if (Token tidak ada?) then (Ya)
    :HTTP 401;
    stop
  endif
  :verifyToken → findUnique user;
  :Kumpulkan field yang ingin diupdate\n(name, email, avatarUrl\nnewPassword, personalContext);
  if (avatarUrl tidak diawali http?) then (Ya)
    :HTTP 400 (cegah XSS);
    stop
  endif
  if (newPassword ada?) then (Ya)
    if (currentPassword tidak ada?) then (Ya)
      :HTTP 400;
      stop
    endif
    :bcrypt.compare currentPassword;
    if (Tidak cocok?) then (Ya)
      :HTTP 401;
      stop
    endif
    :Hash password baru;
  endif
  if (personalContext > 500 char?) then (Ya)
    :HTTP 400;
    stop
  endif
  if (Tidak ada field yang berubah?) then (Ya)
    :HTTP 400;
    stop
  endif
  :prisma.user.update;
  :HTTP 200 data baru;
}

split again
partition "DELETE — Hapus Akun" {
  :Baca cookie token;
  if (Token tidak ada?) then (Ya)
    :HTTP 401;
    stop
  endif
  :verifyToken;
  :prisma.user.delete\n(cascade: chat, history\ntransaction, PromptUsage);
  :Clear cookie token;
  :HTTP 200 "Akun berhasil dihapus";
}

split again
partition "Tab Personalisasi (baru, client-only)" {
  :Pilih 7 preferensi gaya jawaban\n(gaya bahasa, panjang, kutipan\npasal, contoh, langkah praktis, bahasa);
  :Simpan ke localStorage\n(tanyahukum_chat_prefs);
  :Dikirim bersama setiap pertanyaan\nke POST /api/chat (lihat FC-07);
  note right
    TIDAK disimpan ke database.
    Server hanya menerima opsi
    dari whitelist (anti prompt injection).
  end note
}

split again
partition "Tab Akun — Dokumen Legal & Hapus Riwayat (baru)" {
  :Klik "Kebijakan Privasi" /\n"Syarat & Ketentuan";
  :Buka /privacy-policy atau\n/terms-of-service di tab baru (ID/EN);
  :Klik "Hapus Semua Riwayat Chat"\n→ lihat FC-15;
}
end split
stop
@enduml

' ============================================================
' 9. ALUR UPLOAD AVATAR
' ============================================================
@startuml FC-09-UploadAvatar
title FC-09: Alur Upload Avatar\nPOST /api/profile/upload

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start
:Frontend kirim FormData\n{file: imageFile};
:Baca cookie token;

if (Token tidak ada?) then (Ya)
  :HTTP 401;
  stop
endif

:verifyToken → ambil userId;
:Ambil file dari FormData;

if (File tidak ada?) then (Ya)
  :HTTP 400;
  stop
endif

if (Ukuran file > 2MB?) then (Ya)
  :HTTP 400 "Maks 2MB";
  stop
endif

:Ambil ekstensi file;

if (Ekstensi bukan jpg/jpeg/png/webp?) then (Ya)
  :HTTP 400;
  stop
endif

if (MIME type tidak valid?) then (Ya)
  :HTTP 400;
  stop
endif

:Buat nama file: {userId}.{ext};
:Konversi file ke Buffer;
:Upload ke Supabase Storage\nbucket "avatars" (upsert: true);

if (Upload gagal?) then (Ya)
  :HTTP 500;
  stop
endif

:Ambil public URL dari Supabase\n+ timestamp cache-busting;
:Update avatarUrl di DB\n(prisma.user.update);
:Kembalikan HTTP 200\n{url, user};
stop
@enduml

' ============================================================
' 10. ALUR PUSAT DATA HUKUM (REGULATIONS)
' ============================================================
@startuml FC-10-Regulations
title FC-10: Alur Pusat Data Hukum\nGET /api/regulations & /api/regulations/[id]

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start

split
partition "GET /api/regulations — Daftar Regulasi" {
  :Ambil query params\n(page, limit, search, category, sortBy, order);
  :Sanitasi nilai:\n- page: Math.max(1, parseInt || 1)\n- limit: Math.min(100, Math.max(1, ...));

  if (Ada parameter search?) then (Ya)
    :Simpan ke SearchLog\n(async fire-and-forget, tidak block response);
  endif

  :Susun whereClause:\n- isActive: true\n- search: OR(title, description) ILIKE\n- category (jika bukan "Semua");

  :Promise.all:\n1. findMany (data)\n2. count (total);
  :Hitung pagination meta\n(totalPages, currentPage, dll);
  :Kembalikan HTTP 200\n{data, meta};
}

split again
partition "GET /api/regulations/[id] — Detail Regulasi" {
  :Ambil id dari URL params;

  if (id tidak ada?) then (Ya)
    :HTTP 400;
    stop
  endif

  :findUnique berdasarkan id;

  if (Regulasi tidak ditemukan?) then (Ya)
    :HTTP 404;
    stop
  endif

  :Increment viewCount +1\n(fire-and-forget, tidak block);
  :Kembalikan HTTP 200\n{data: regulation};
}

end split
stop
@enduml

