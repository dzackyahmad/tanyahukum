' ============================================================
' 15. ALUR HAPUS SEMUA RIWAYAT CHAT (BARU — 16 Okt 2026)
' ============================================================
@startuml FC-15-DeleteAllHistory
title FC-15: Alur Hapus Semua Riwayat Chat\nDELETE /api/chat/history (konfirmasi 2 langkah)

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start
:Pengguna buka Profil > Akun;
:Klik "Hapus Semua Riwayat Chat";
:Tampil dialog langkah 1\n(penjelasan konsekuensi);

if (Klik "Batal"?) then (Ya)
  stop
endif

:Klik "Lanjutkan";
:Tampil dialog langkah 2\n(input teks, placeholder "HAPUS");
:Pengguna mengetik konfirmasi;

if (Teks ketikan = "HAPUS"\npersis?) then (Tidak)
  :Tombol konfirmasi tetap nonaktif;
  stop
endif

:Klik tombol konfirmasi akhir;
:Frontend kirim DELETE /api/chat/history\n{confirm: "HAPUS"};

:Verifikasi sesi (getSession);
if (Sesi tidak ada?) then (Ya)
  :Kembalikan HTTP 401;
  stop
endif

if (rateLimit(userId, 3/menit,\n"chat-delete-all") terlampaui?) then (Ya)
  :Kembalikan HTTP 429;
  stop
endif

:Parse body JSON;
if (body.confirm !== "HAPUS"?) then (Ya)
  :Kembalikan HTTP 400\n"Konfirmasi tidak valid.";
  stop
endif

:prisma.chat.deleteMany({where: {userId}});
note right
  Cascade delete: seluruh ChatHistory
  ikut terhapus otomatis.
  PromptUsage TIDAK ikut terhapus
  -> kuota harian TIDAK kembali.
  Akun, profil, langganan tetap aman.
end note

:Kembalikan HTTP 200\n{success: true, deletedChats: n};
:Frontend kosongkan sidebar riwayat\ntampilkan "N percakapan telah dihapus";
stop
@enduml

' ============================================================
' 16. ALUR STOP & EDIT PERTANYAAN (BARU — 16 Okt 2026)
' ============================================================
@startuml FC-16-StopEdit
title FC-16: Alur Hentikan Jawaban (Stop) & Edit Pertanyaan\nAbortController pada POST /api/chat {stream:true}

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start
:AI sedang menulis jawaban (streaming);
:Tombol Kirim berubah jadi tombol Stop;

if (Pengguna klik Stop?) then (Tidak)
  :Jawaban selesai normal,\ntersimpan ke riwayat (lihat FC-07);
  stop
endif

:Frontend panggil reader.cancel();
:Server: cancelled = true,\nabortController.abort();
:Request ke Gemini/Groq diputus\n(AbortError ditangkap, bukan error ke user);

if (Jawaban sudah sempat\nditulis sebagian?) then (Ya)
  :Server catat promptUsage.create\n(kuota tetap terpakai);
else (belum sempat menulis)
  :Tidak ada apapun yang dicatat/disimpan;
endif

:Server tidak memanggil chatHistory.create\n→ riwayat TIDAK tersimpan;
:Frontend tandai pesan\n"Dihentikan - tidak disimpan";
:Teks jawaban sebagian tetap\nterlihat di layar (tidak hilang);
:Tampilkan tombol Edit\npada bubble pertanyaan pengguna;

if (Pengguna klik Edit?) then (Tidak)
  stop
endif

:Tampilkan kotak edit\n(isi awal = pertanyaan sebelumnya);
:Pengguna ubah teks pertanyaan;
:Klik "Kirim ulang";
:Hapus pasangan pesan lama\n(yang berstatus dihentikan) dari layar;
:Kirim ulang sebagai pertanyaan baru\n→ kembali ke FC-07;
stop
@enduml

' ============================================================
' 17. ALUR PERSONALISASI GAYA JAWABAN (BARU — opsional)
' ============================================================
@startuml FC-17-Preferences
title FC-17: Alur Personalisasi Gaya Jawaban AI\nTab Profil > Personalisasi (client-only)

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start
:Pengguna buka Profil > Personalisasi;
:Tampilkan 7 dropdown preferensi:\ngaya bahasa, panjang jawaban, judul & daftar,\nkutipan pasal, contoh penerapan,\nlangkah praktis, bahasa jawaban;

:Pengguna ubah salah satu opsi;
:Simpan ke localStorage\n(tanyahukum_chat_prefs)\n[tanpa panggilan API];
:Tampilkan indikator "Tersimpan";

:Pengguna mengajukan pertanyaan baru;
:Frontend sertakan preferensi\ndi body POST /api/chat {preferences};

:Server: sanitizePreferences(preferences)\n— hanya kunci & nilai dari whitelist diterima;

if (Ada nilai di luar whitelist\n(mis. teks bebas)?) then (Ya)
  :Nilai tersebut DIABAIKAN\n(anti prompt injection);
endif

:buildPreferenceInstructions()\n→ disisipkan ke system prompt\n(aturan 1 Keakuratan & aturan 3 Kutipan\nSumber tetap wajib diikuti);
:Lanjut ke FC-07 (RAG Pipeline)\ndengan prompt yang sudah disesuaikan;
stop
@enduml

' ============================================================
' 18. ACTIVITY CHATBOT (G-20) — pengganti PlantUML untuk 2.98
' ============================================================
@startuml ACT-01-ChatbotActivity
title G-20: Activity Diagram — Alur Chatbot (swimlane)\nversi PlantUML, pengganti diagram non-PlantUML tim (Gambar 2.98)

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c
skinparam PartitionBackgroundColor #FDEBD0
skinparam PartitionBorderColor #e67e22

|Pengguna|
start
:Buka halaman Chatbot;
:Pilih model & mode\n(5 model x Kilat/Berpikir);
:Ketik pertanyaan hukum;
:Klik Kirim;

|Sistem|
:Verifikasi sesi & rate limit\n(15 req/menit);
:Cek kuota harian\n(PromptUsage FREE: 10/hari);
if (Kuota habis?) then (Ya)
  :Kirim event error\n(limitReached);
  |Pengguna|
  :Lihat pesan batas tercapai;
  stop
endif

:Retrieval dokumen\n(embedding + Pinecone topK 50\n+ saring noise);
:Susun prompt\n(+ personalisasi bila ada);
:Panggil model sesuai mode\n(Gemini atau Groq);

if (Model gagal sebelum menulis\n& ada cadangan?) then (Ya)
  :Fallback ke model berikutnya\n(rantai Gemini);
endif

:Stream jawaban\n(step, sources, model, thinking, text);

|Pengguna|
:Lihat jawaban muncul bertahap\n+ panel Proses;

fork
  :Tunggu sampai selesai;
fork again
  if (Klik Stop?) then (Ya)
    |Sistem|
    :Abort stream\n(AbortController);
    if (Sudah ada teks tertulis?) then (Ya)
      :Catat PromptUsage\n(kuota tetap terpakai);
    endif
    :Tidak simpan ke riwayat\n("Dihentikan · tidak disimpan");
    |Pengguna|
    :Lihat tombol Edit\npada pertanyaan;
    stop
  endif
end fork

|Sistem|
:Simpan Chat + ChatHistory\n+ PromptUsage;
:Kirim event done;

|Pengguna|
:Baca jawaban lengkap\ndengan sitasi [1][2][3];
:(Opsional) klik sitasi,\nSalin, atau Ulangi;
stop
@enduml

