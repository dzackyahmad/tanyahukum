' ============================================================
' WB-19: POST /api/payment/webhook — CC=10
' ============================================================
@startuml WB-19-Webhook
title WB-19: Control Flow — POST /api/payment/webhook\nCC=10 | Branch Coverage=100% | Basis Path=10

skinparam activity {
  BackgroundColor #EEF4FF
  BorderColor #2f6fed
  DiamondBackgroundColor #FDEBD0
  DiamondBorderColor #e67e22
  ArrowColor #2c3e50
  FontSize 11
}

start
if (B1: Mode production?) then (Ya)
  :hitung SHA512 signature;
  if (B2: Signature tidak cocok?) then (Ya)
    :HTTP 403 - Invalid Signature; <<#FADBD8>>
    stop
  endif
else (Sandbox)
  :bypass signature check;
endif
:mapping status Midtrans ke internal;
if (B3: capture atau settlement?) then (Ya)
  if (B4: fraud=challenge?) then (Ya)
    :finalStatus = PENDING;
  else (Tidak)
    :finalStatus = SUCCESS;
  endif
else if (B5: cancel atau deny atau expire?) then (Ya)
  :finalStatus = FAILED;
else
  :finalStatus = PENDING default;
endif
:DB transaction.findUnique orderId;
if (B6: Transaksi tidak ada?) then (Ya)
  :HTTP 404; <<#FADBD8>>
  stop
endif
if (B7: Status sudah SUCCESS - idempotency?) then (Ya)
  :HTTP 200 - Already processed; <<#D5F5E3>>
  stop
endif
if (B8: finalStatus = SUCCESS?) then (Ya)
  :DB atomic:\nupdate tx SUCCESS\nupdate user tier=PRO promptLimit=0;
else (FAILED atau PENDING)
  :DB transaction.update finalStatus;
endif
:HTTP 200 OK; <<#D5F5E3>>
stop
@enduml

