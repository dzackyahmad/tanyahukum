'==============================================================
' WHITEBOX TESTING — CONTROL FLOW DIAGRAMS
' Berdasarkan WHITEBOX_TESTING_REPORT_FINAL.md
' CC = Cyclomatic Complexity | Setiap diamond = titik keputusan
'==============================================================

' ============================================================
' WB-01: POST /api/auth/login — CC=9
' ============================================================
@startuml WB-01-Login
title WB-01: Control Flow — POST /api/auth/login\nCC=19 (ESLint, diperbarui) | Basis diagram disederhanakan dari && / || majemuk

skinparam activity {
  BackgroundColor #EEF4FF
  BorderColor #2f6fed
  DiamondBackgroundColor #FDEBD0
  DiamondBorderColor #e67e22
  ArrowColor #2c3e50
  FontSize 11
}

start
if (B4: Rate limit IP\n(5/menit, scope "login")?) then (Ya)
  :HTTP 429; <<#FADBD8>>
  stop
endif
if (B5: Body bukan JSON?) then (Ya)
  :HTTP 400 - body tidak valid; <<#FADBD8>>
  stop
endif
if (B1: Tipe bukan string?) then (Ya)
  :HTTP 400 - input tidak valid; <<#FADBD8>>
  stop
endif
if (B2: Email kosong / regex gagal?) then (Ya)
  :HTTP 400 - format email; <<#FADBD8>>
  stop
endif
if (B3: Password < 8 karakter?) then (Ya)
  :HTTP 400 - password minimal 8; <<#FADBD8>>
  stop
endif
if (B6: Validasi gagal?) then (Ya)
  :HTTP 400; <<#FADBD8>>
  stop
endif
:Normalisasi email (lowercase);
if (B7 BARU: Rate limit per email\n(10/menit, scope "login-email")?) then (Ya)
  :HTTP 429; <<#FADBD8>>
  stop
endif
:DB findUnique(email)\nbcrypt.compare(password, hash) - anti-timing attack;
if (B8 BARU: Gagal DAN user ada\nDAN password punya spasi di awal/akhir?) then (Ya)
  :bcrypt.compare(password.trim(), hash);
  note right
    Perbaikan BUG-07: registrasi
    menyimpan password ter-trim.
  end note
endif
if (B9: user null ATAU password\n(trim) tidak cocok?) then (Ya)
  :HTTP 401 - email atau password salah; <<#FADBD8>>
  stop
endif
:createToken - set Cookie HttpOnly 7 hari;
:HTTP 200 + data user; <<#D5F5E3>>
note right
  CC=19 juga menghitung operator && / || / ??
  di dalam kondisi majemuk (B8, B9, dan
  "user?.passwordHash ?? dummyHash"),
  yang di diagram ini disatukan jadi 1 diamond
  agar tetap mudah dibaca.
end note
stop
@enduml

