' ============================================================
' WB-10: POST /api/chat — CC=11
' ============================================================
@startuml WB-10-PostChat
title WB-10: Control Flow — POST /api/chat (handler utama)\nCC=25 (ESLint, diperbarui) | Dipecah 2 diagram: lihat WB-10b untuk mode streaming

skinparam activity {
  BackgroundColor #EEF4FF
  BorderColor #2f6fed
  DiamondBackgroundColor #FDEBD0
  DiamondBorderColor #e67e22
  ArrowColor #2c3e50
  FontSize 11
}

start
if (B1: Tidak ada sesi JWT?) then (Ya)
  :HTTP 401; <<#FADBD8>>
  stop
endif
:body = await req.json();
if (B2: message kosong?) then (Ya)
  :HTTP 400; <<#FADBD8>>
  stop
endif
if (B3: message bukan string\nATAU > 5000 karakter?) then (Ya)
  :HTTP 400; <<#FADBD8>>
  stop
endif
if (B4: rateLimit(userId, 15/menit, "chat")\nterlampaui?) then (Ya)
  :HTTP 429; <<#FADBD8>>
  stop
endif
:mode = CHAT_MODES.includes(body.mode)\n? body.mode : "deep";
:preferences = sanitizePreferences(body.preferences)\n(whitelist, anti prompt injection);
if (B5: chatId ada tapi\nbukan string?) then (Ya)
  :HTTP 404; <<#FADBD8>>
  stop
endif
:Baca DB paralel (Promise.all):\nexistingChat, user, chatsTodayCount\n(= count PromptUsage hari ini);
if (B6: chatId ada tapi bukan\nmilik user?) then (Ya)
  :HTTP 404; <<#FADBD8>>
  stop
endif
if (B7: user tidak ditemukan?) then (Ya)
  :HTTP 404; <<#FADBD8>>
  stop
endif
if (B8: tier=FREE DAN\nchatsTodayCount >= promptLimit?) then (Ya)
  :HTTP 403 - limitReached: true; <<#FADBD8>>
  stop
endif

if (B9: body.stream === true?) then (Ya)
  :streamChatResponse(...)\n→ lihat WB-10b (NDJSON streaming); <<#D6EAF8>>
  stop
else (Tidak - mode JSON lama)
endif

:retrieveDocuments(message)\n(Voyage embed + Pinecone topK 50);
repeat :Ambil model berikutnya\ndari MODEL_CHAIN;
  :createLlm(model).invoke(\n[SystemMessage, HumanMessage]);
  if (B10: LLM error DAN isQuotaError\nDAN masih ada model lain?) then (Ya)
    :lanjut ke model berikutnya;
  elseif (B11: LLM error DAN isQuotaError?) then (Ya)
    :HTTP 429 - Kuota AI habis; <<#FADBD8>>
    stop
  elseif (B12: LLM error lain?) then (Ya)
    :lempar exception → HTTP 500; <<#FADBD8>>
    stop
  else (Berhasil)
    :break;
  endif
repeat while (Model berikutnya\ntersedia?) is (Ya) not (Tidak, berhasil)

:saveExchange(): chat.create/findUnique\n+ simpan ChatHistory USER & AI;
if (B13: chatSession tidak\nditemukan?) then (Ya)
  :HTTP 404; <<#FADBD8>>
  stop
endif
:HTTP 200 - {answer, chatId}; <<#D5F5E3>>
note right
  CC=25 juga menghitung operator && / ?? di
  kondisi majemuk dan di helper (modelChainFor,
  isQuotaError, isTransientError). Beberapa
  diamond di atas mewakili beberapa titik
  keputusan ESLint sekaligus.
end note
stop
@enduml

' ============================================================
' WB-10b: streamChatResponse (ReadableStream.start) — bagian
' dari POST /api/chat mode stream:true — CC=25 (ESLint)
' ============================================================
@startuml WB-10b-StreamChatResponse
title WB-10b: Control Flow — streamChatResponse (mode streaming)\nCC=25 (ESLint) | Dipanggil dari WB-10 saat body.stream===true

skinparam activity {
  BackgroundColor #EEF4FF
  BorderColor #2f6fed
  DiamondBackgroundColor #FDEBD0
  DiamondBorderColor #e67e22
  ArrowColor #2c3e50
  FontSize 11
}

start
:Kirim event "step" {search, active};
:retrieveDocuments(message)\n(Voyage embed + Pinecone topK 50\n+ cleanMatches noise filter);
if (B1: cancelled (Stop ditekan)\nsebelum AI dipanggil?) then (Ya)
  :return - tidak ada yang disimpan;
  stop
endif
:Kirim event "sources" + "step" {search, done};
:bangun systemPrompt (konteks\n+ personalContext + preferences);

repeat :Ambil model berikutnya\ndari modelChainFor(mode);
  :Kirim event "model" {model, provider,\nmode, fallback: i>0};
  :stream(systemPrompt, message,\nAbortController.signal);
  if (B2: cancelled saat streaming\nchunk?) then (Ya)
    :break - keluar loop chunk;
  elseif (B3: chunk type = thinking?) then (Ya)
    :kirim event "thinking";
  else (chunk type = text)
    :writing = true (jika pertama kali)\nkirim event "text";
  endif

  if (B4: LLM error DAN cancelled?) then (Ya)
    :break - dihentikan pengguna,\nbukan error;
  elseif (B5: LLM error DAN canUseFallback(err)\nDAN !writing DAN masih ada model lain?) then (Ya)
    :continue - coba model berikutnya\n(fallback=true pada event berikutnya);
  elseif (B6: LLM error DAN isQuotaError(err)?) then (Ya)
    :kirim event "error"\n"Kuota AI hari ini telah habis";
    stop
  elseif (B7: LLM error lain?) then (Ya)
    :lempar exception; <<#FADBD8>>
    stop
  else (Berhasil, selesai menulis)
    :usedModel = model; break;
  endif
repeat while (Model lain\ntersedia?) is (Ya) not (Tidak)

if (B8: cancelled (Stop ditekan)?) then (Ya)
  if (B9: answer.trim() tidak kosong\n(sudah sempat menulis)?) then (Ya)
    :recordUsage(userId)\n→ promptUsage.create;
  endif
  :return - TIDAK memanggil\nsaveExchange/chatHistory.create;
  stop
endif

if (B10: answer kosong?) then (Ya)
  :throw "Jawaban AI kosong" → catch luar; <<#FADBD8>>
  stop
endif

:saveExchange(): simpan Chat,\nChatHistory USER+AI, Chat.updatedAt;
if (B11: chatSession tidak\nditemukan?) then (Ya)
  :kirim event "error"\n"Sesi chat tidak ditemukan";
  stop
endif
:kirim event "step" {write, done};
:kirim event "done"\n{chatId, answer, model, mode, durationMs}; <<#D5F5E3>>
note right
  Tombol Stop memicu ReadableStream.cancel()
  -> cancelled=true + abortController.abort().
  Error tak tertangani di luar percabangan ini
  ditangkap catch terluar -> event "error" generik.
end note
stop
@enduml

